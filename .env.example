# Copie este arquivo para .env antes de executar "docker compose up"
# Nunca versione o arquivo .env real no Git.

# Banco de dados PostgreSQL
POSTGRES_DB=planejamento_financeiro
POSTGRES_USER=agro_user
POSTGRES_PASSWORD=troque_esta_senha_banco_local
POSTGRES_PORT=5432

# Backend Spring Boot
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# Chave Base64 ou texto >= 32 bytes para assinatura JWT (trocar em producao)
JWT_SECRET=troque_esta_chave_jwt_desenvolvimento_minimo_32_caracteres_123456
JWT_EXPIRATION_MS=86400000

# Frontend Vite / Nginx
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api
VITE_DEMO_MODE=false
